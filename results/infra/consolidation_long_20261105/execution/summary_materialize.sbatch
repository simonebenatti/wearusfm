#!/bin/bash
set -euo pipefail
test "${EXPECTED_SHA:?}" = d75106304d1592fbea6d81fc4c1220e669cffecf
test "${CODE_DIR:?}" = /leonardo_work/IscrB_WearUsFM/wearusfm_campaigns/consolidation-long-aggregate-20261105
export LONG_PLAN_
export LONG_SUMMARY_PLAN=/leonardo_scratch/large/userexternal/sbenatti/wearusfm_runs/results/consolidation_long_20261105/manifests/summary_plan_f7728778681431314849ff6f21ba55695ebab799d74f806347faf9eba3286a50.json
export LONG_PLAN_SHA256=f7728778681431314849ff6f21ba55695ebab799d74f806347faf9eba3286a50
export LONG_PLAN_BYTES=53847
export LONG_APPROVED_OUTPUT_ROOT=/leonardo_scratch/large/userexternal/sbenatti/wearusfm_runs/results/consolidation_long_20261105
python3 - <<'PY_PLAN'

import base64,hashlib,os
from pathlib import Path
raw=base64.b64decode(os.environ["LONG_PLAN_B64"],validate=True)
target=Path(os.environ["LONG_SUMMARY_PLAN"])
assert hashlib.sha256(raw).hexdigest()==os.environ["LONG_PLAN_SHA256"]
assert len(raw)==int(os.environ["LONG_PLAN_BYTES"])
root=Path(os.environ["LONG_APPROVED_OUTPUT_ROOT"])
assert target.is_absolute() and root in target.parents
assert not target.exists() and not target.is_symlink()
assert not any(p.is_symlink() for p in target.parents)
target.parent.mkdir(parents=True,exist_ok=True)
with target.open("xb") as stream:stream.write(raw)
target.chmod(0o444)
assert hashlib.sha256(target.read_bytes()).hexdigest()==os.environ["LONG_PLAN_SHA256"]

PY_PLAN
exec bash /leonardo_work/IscrB_WearUsFM/wearusfm_campaigns/consolidation-long-aggregate-20261105/scripts/slurm/consolidation_long.sbatch --plan /leonardo_scratch/large/userexternal/sbenatti/wearusfm_runs/results/consolidation_long_20261105/manifests/summary_plan_f7728778681431314849ff6f21ba55695ebab799d74f806347faf9eba3286a50.json --expected-code d75106304d1592fbea6d81fc4c1220e669cffecf --stage summary --out /leonardo_scratch/large/userexternal/sbenatti/wearusfm_runs/results/consolidation_long_20261105/summary
