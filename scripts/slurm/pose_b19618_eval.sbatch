#!/bin/bash
# Generated by scripts/build_pose_b19618_eval_payloads.py; submit on stdin.
# Default CPU probe cap. Pose/channel submissions MUST override partition,
# GPU, memory and walltime according to the frozen plan; compare uses CPU.
#SBATCH -A IscrB_WearUsFM
#SBATCH -p lrd_all_serial
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=04:00:00
#SBATCH -o /leonardo_work/IscrB_WearUsFM/wearusfm_runs/logs/pose_b19618_eval_%j.out
#SBATCH -e /leonardo_work/IscrB_WearUsFM/wearusfm_runs/logs/pose_b19618_eval_%j.out
set -euo pipefail
: "${CODE_DIR:?}" "${EXPECTED_SHA:?}" "${WRAPPER_SHA256:?}" "${WORK:?}" "${B19618_ARGS_B64:?}"
[ "$EXPECTED_SHA" = 24139ab901c052357a46a65bc20466f2eb1e8358 ] || exit 2
source "$CODE_DIR/scripts/slurm/lib_code_dir.sh"
code_dir_setup
module purge
module load profile/deeplrn
module load cineca-ai/4.3.0
source "$WORK/venv_wearusfm/bin/activate"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" OPENBLAS_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export MKL_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}" PYTHONDONTWRITEBYTECODE=1
B19618_EVAL_TMP=$(mktemp -d "${TMPDIR:-/tmp}/wearusfm-b19618-eval.XXXXXX")
trap 'rm -f -- "$B19618_EVAL_TMP/pose_b19618_eval_guard.py"; rmdir -- "$B19618_EVAL_TMP"' EXIT
cat > "$B19618_EVAL_TMP/pose_b19618_eval_guard.py" <<'WEARUSFM_B19618_EVAL_SOURCE'
"""Guarded B/R3c step19618 pose and teacher-channel extraction.

Science remains in the immutable 24139ab checkout. This controller verifies
receipts and inputs, runs frozen extractors, and attests fresh cache files.
"""
from __future__ import annotations

import argparse
import csv
import gzip
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

import numpy as np

CODE_SHA = '24139ab901c052357a46a65bc20466f2eb1e8358'
STATS_SHA = '757f2aeebf688063747d50e55d983dd6b3c4cea268ce43d2bae06f3e99524a7e'
MANIFEST_SHA = '6d6d8167b882eb4079fcc566748028dc6de81692859f220a0246291c198574ec'
CSV_SHA = '0e7ad04a79a0f162385d22ec8d6f43af9b8360978ca11ef9d601bbf9594b09e6'
REFERENCE_SHAS = {'train':'1bcb387ed4b5c178146f224e2e84e2547d2f970439a4e3105ed86c50af5d6ee6',
                  'val':'70bb551309b502565d38072abf41ffee322a06de14589d36b720570f1cfbfa46'}
DATASETS = {'p1':['ninapro_db2','ninapro_db3','ninapro_db6'], 'p2':['epn612','uci_emg']}


def require(ok, message):
    if not ok:
        raise ValueError(message)


def sha(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as f:
        for block in iter(lambda:f.read(8*1024*1024),b''):
            h.update(block)
    return h.hexdigest()


def is_sha(value):
    return isinstance(value,str) and len(value)==64 and all(c in '0123456789abcdef' for c in value)


def fresh(path, roots):
    require(path.is_absolute() and not path.exists() and not path.is_symlink(), 'output must be absolute and new')
    require(not any(path.resolve()==r.resolve() or r.resolve() in path.resolve().parents for r in roots), 'output inside code')


def receipt_identity(receipt, checkpoint, model, receipt_path):
    if model == 'B':
        require(receipt.get('complete') is True, 'receipt incomplete')
        require(receipt.get('expected_step') == 19618 and receipt.get('source_unchanged') is True, 'B continuation incomplete/source changed')
        require(receipt.get('code_sha') == CODE_SHA, 'B training code mismatch')
        require(checkpoint.name == 'checkpoint_step0019618.pt' and checkpoint.parent.resolve() == receipt_path.parent.resolve(),
                'B checkpoint/receipt path mismatch')
        digest = receipt['outputs'][checkpoint.name]['sha256']
        config_sha = receipt['outputs']['config.json']['sha256']
    else:
        require(receipt.get('completed') is True, 'preflight receipt incomplete')
        require(receipt.get('provenance',{}).get('environment_code_sha') == CODE_SHA, 'preflight execution code mismatch')
        attested = receipt['R3c19618']
        require(attested.get('step') == 19618 and Path(attested['path']).resolve() == checkpoint.resolve(), 'R3c checkpoint identity mismatch')
        require(Path(attested['config_path']).resolve() == (checkpoint.parent/'config.json').resolve(), 'R3c config path mismatch')
        digest, config_sha = attested['sha256'], attested['config_file_sha256']
    require(is_sha(digest) and is_sha(config_sha), 'invalid receipt hashes')
    return digest, config_sha


def check_checkpoint(path, model, receipt, receipt_path):
    import torch
    digest, config_sha = receipt_identity(receipt,path,model,receipt_path)
    require(sha(path) == digest and sha(path.parent/'config.json') == config_sha, 'checkpoint/config SHA mismatch')
    # Trusted campaign pickle, only after its receipt's digest has matched.
    state = torch.load(path,map_location='cpu',weights_only=False)
    config = json.loads((path.parent/'config.json').read_text())
    require(state.get('step') == 19618, 'wrong checkpoint step')
    # R3c's run config may have a later operational max_steps; other fields must match.
    require({k:v for k,v in state['config'].items() if k!='max_steps'} == {k:v for k,v in config.items() if k!='max_steps'},
            'checkpoint/config recipe mismatch')
    expect_head = model == 'B'
    require(bool(state['config']['model'].get('pose_head',False)) == expect_head, 'unexpected pose head')
    require(state.get('pose_stats_sha256') == (STATS_SHA if expect_head else None), 'checkpoint pose stats mismatch')
    for which in ('student','teacher'):
        require(isinstance(state.get(which),dict) and bool(state[which]), 'missing '+which)
        present = any(k.startswith('pose_head.') for k in state[which])
        require(present == expect_head, 'state/head config disagreement')
        require(all(bool(torch.isfinite(v).all()) for v in state[which].values()), 'nonfinite checkpoint tensors')
    return digest,config_sha


def pose_command(code,checkpoint,out,split,work,scratch):
    command = [sys.executable,str(code/'scripts/pose_eval.py'),'--stage','extract','--checkpoint',str(checkpoint),
               '--which','student','--csv',str(work/'data/raw/emg2pose_mini/emg2pose_metadata.csv'),
               '--processed-root',str(scratch/'data/processed/emg2pose'),'--pose-root',str(scratch/'data/processed/emg2pose_pose'),
               '--split',split,'--n-windows','10','--window-s','4','--seed','20261026','--batch','32','--device','cuda','--out',str(out)]
    if split == 'train':
        command += ['--n-users','40','--n-recordings','200']
    return command


def channel_command(code,checkpoint,out,task,work,scratch):
    command = [sys.executable,str(code/'scripts/channel_readout.py'),'--stage','extract','--checkpoint',str(checkpoint),
               '--root',str(work/'data/processed'),'--root',str(scratch/'data/processed'), '--features',str(out),
               '--task',task,'--device','cuda','--datasets',*DATASETS[task]]
    if task == 'p2':
        command += ['--epn-root',str(work/'data/raw/epn612/EMG-EPN612 Dataset/trainingJSON'),
                    '--epn-root',str(work/'data/raw/epn612/EMG-EPN612 Dataset/testingJSON'),
                    '--uci-root',str(work/'data/raw/uci_emg')]
    # Frozen channel_readout.extract_* loads teacher explicitly, no which flag.
    return command


def pose_input_checks(work,scratch):
    from wearusfm.data import pose_targets as PT
    from wearusfm.harness import pose_eval as PE
    from wearusfm.ingest.emg2pose import _SAFE_RE
    normalize = lambda u: 'u'+_SAFE_RE.sub('_',str(u)).removeprefix('u')
    manifest = work/'wearusfm_runs/results/passo6/derived_v1_1/manifest_v1_1_nested_1.json.gz'
    csv_path = work/'data/raw/emg2pose_mini/emg2pose_metadata.csv'
    pose_root,processed = scratch/'data/processed/emg2pose_pose',scratch/'data/processed/emg2pose'
    for path,digest in ((manifest,MANIFEST_SHA),(csv_path,CSV_SHA),(pose_root/PT.STATS_FILE,STATS_SHA)):
        require(sha(path)==digest,'data input SHA mismatch: '+str(path))
    with gzip.open(manifest,'rt') as f:
        mf = json.load(f)
    train_users = {normalize(r['subject']) for row in mf['rows'] for r in [dict(zip(mf['columns'],row))]
                   if r['dataset']=='emg2pose' and r['split']=='pretraining'}
    with csv_path.open(newline='') as f:
        val_users = {normalize(r['user']) for r in csv.DictReader(f) if r['split']=='val'}
    require(len(train_users)==158 and len(val_users)==15 and train_users.isdisjoint(val_users),'train/val users overlap or counts changed')
    records = {}
    for split in ('train','val'):
        selected = PE.recordings_for(csv_path,processed,split,n_users=40 if split=='train' else None,
                                     n_recordings=200 if split=='train' else None,seed=20261026)
        users = {normalize(r['user']) for r in selected}
        require(len(selected)==(200 if split=='train' else 1950) and len(users)==(40 if split=='train' else 15),'recording/user coverage changed')
        require(users <= (train_users if split=='train' else val_users),'selected user outside split')
        for row in selected:
            directory = Path(row['path'])
            require(all(p.is_file() and p.stat().st_size>0 for p in
                        (directory/'metadata.json',directory/'data_int16.npy',PT.pose_dir(pose_root,directory)/PT.POSE_FILE,
                         PT.pose_dir(pose_root,directory)/PT.VALID_FILE)), 'recording input missing')
        records[split] = selected
    return records


def verify_pose_cache(path,reference,model,split,checkpoint):
    # Selective read: comparison never needs a second copy of large latents.
    with np.load(path,allow_pickle=False) as new, np.load(reference,allow_pickle=False) as old:
        cfg = json.loads(str(new['config_json']))
        ref_cfg = json.loads(str(old['config_json']))
        for key,value in {'checkpoint':str(checkpoint),'which':'student','split':split,'code_sha':CODE_SHA,
                          'pose_stats_sha256':STATS_SHA,'checkpoint_pose_stats_sha256':STATS_SHA if model=='B' else None}.items():
            require(cfg.get(key)==value,'new pose cache config mismatch: '+key)
        for key in ('n_windows','window_s','seed','pose_root','per_side'):
            require(cfg.get(key)==ref_cfg.get(key),'pose reference recipe mismatch: '+key)
        require(bool(new['has_head']) == (model=='B'),'pose cache head mismatch')
        require(int(new['n_recordings'])==int(old['n_recordings'])==(200 if split=='train' else 1950),'pose recording count mismatch')
        meta = json.loads(str(new['meta_json']))
        require(meta==json.loads(str(old['meta_json'])),'pose metadata differs from B5000')
        for key in ('target','mask','std','pose_var'):
            a,b = new[key],old[key]
            require(a.shape==b.shape and a.dtype==b.dtype and np.array_equal(a,b,equal_nan=True),'pose reference differs: '+key)
        mask,pred = new['mask'],new['pred']
        require(mask.ndim==3 and mask.shape[-1]==20 and mask.dtype==bool and pred.shape==mask.shape,'pose array shapes/types')
        require(np.isfinite(pred[mask]).all(),'nonfinite supported prediction')
        lat = new['lat']
        require(lat.shape == (*mask.shape[:2],384) and lat.dtype==np.float16,'latent shape/dtype mismatch')
        for start in range(0,len(lat),128):
            require(np.isfinite(lat[start:start+128][mask[start:start+128].any(axis=2)]).all(),'nonfinite supported latent')
        if model=='R3c':
            require(not np.any(pred),'headless R3c cache has nonzero placeholder predictions')
        valid = mask.any(axis=(1,2))
        users = {m['user'] for m in meta}
        supported = {m['user'] for m,v in zip(meta,valid) if v}
        require(users==supported and len(users)==(40 if split=='train' else 15),'pose user coverage changed')
        rows = mask.any(axis=2)
        return {'config':cfg,'n_recordings':int(new['n_recordings']),'n_windows':len(meta),'n_users':len(users),
                'n_windows_with_valid_pose':int(valid.sum()),'n_valid_elements':int(mask.sum()),
                'n_rows_any_valid':int(rows.sum()),'n_rows_partial_joints':int((rows&~mask.all(axis=2)).sum()),
                'n_valid_per_joint':mask.sum(axis=(0,1)).tolist(),'has_head':bool(new['has_head']),
                'same_metadata_target_mask_std_pose_var_as_B5000':True}


def verify_channel_cache(path,task,checkpoint,digest):
    with np.load(path,allow_pickle=False) as z:
        for key,value in {'checkpoint':str(checkpoint),'checkpoint_sha256':digest,'task':task,'code_sha':CODE_SHA,
                          'protocol':'readout_per_canale_v1'}.items():
            require(str(z[key])==value,'channel cache mismatch: '+key)
        recipe = json.loads(str(z['extraction_recipe']))
        require(recipe.get('encoder')=='teacher','channel encoder must be teacher')
        n = len(z['y'])
        require(n>0 and len(z['s'])==n,'empty/inconsistent channel samples')
        for key in ('x_local','x_dec','x_pool'):
            x = z[key]
            require(len(x)==n and np.isfinite(x).all(),'invalid channel feature '+key)
        return {'n_windows':n,'n_subjects':len(z['subjects']),'input_sha256':str(z['input_sha256']),
                'splits_sha256':str(z['splits_sha256']),'extraction_recipe':recipe,'which':'teacher'}


def write_json(path,value):
    with path.open('x') as f:
        json.dump(value,f,indent=2,allow_nan=False)
        f.write('\n')


def probe_command(code,features,out,task):
    return [sys.executable,str(code/'scripts/channel_readout.py'),'--stage','probe','--task',task,
            '--features',str(features),'--out',str(out),'--layer','pool','--k','0','--seed','0',
            '--datasets',*DATASETS[task]]


def guarded_features(features,receipt_path,model,task):
    receipt = json.loads(receipt_path.read_text())
    require(receipt.get('complete') is True and receipt.get('checkpoint_unchanged') is True, 'extraction incomplete')
    require(receipt.get('model')==model and receipt.get('mode')=='channel' and receipt.get('checkpoint_step')==19618
            and receipt.get('code_sha')==CODE_SHA,'extraction identity mismatch')
    require(set(receipt['outputs'])==set(DATASETS[task]),'wrong extraction datasets/task')
    origin = Path(receipt['receipt'])
    require(sha(origin)==receipt['receipt_sha256'],'checkpoint receipt changed')
    digest,config_sha = receipt_identity(json.loads(origin.read_text()),Path(receipt['checkpoint']),model,origin)
    require(digest==receipt['checkpoint_sha256'] and config_sha==receipt['config_file_sha256'],'extraction checkpoint identity differs')
    require(sha(Path(receipt['checkpoint']).parent/'config.json')==config_sha,'checkpoint config changed')
    inputs = {}
    for ds in DATASETS[task]:
        path = features/(ds+'.npz')
        entry = receipt['outputs'][ds]
        require(Path(entry['cache']).resolve()==path.resolve() and sha(path)==entry['sha256'],'feature cache changed')
        provenance_path = Path(str(path)+'.provenance.json')
        require(sha(provenance_path)==entry['provenance_sha256'],'feature provenance changed')
        provenance = json.loads(provenance_path.read_text())
        for key,value in {'model':model,'task':task,'which':'teacher','checkpoint_step':19618,
                          'checkpoint_sha256':digest,'code_sha':CODE_SHA,'cache_sha256':entry['sha256']}.items():
            require(provenance.get(key)==value,'feature provenance mismatch: '+key)
        support = verify_channel_cache(path,task,Path(receipt['checkpoint']),digest)
        inputs[ds] = {'path':str(path),'sha256':entry['sha256'],'input_sha256':support['input_sha256'],
                      'splits_sha256':support['splits_sha256']}
    return receipt,inputs


def check_classification_labels(y,p):
    """OOF labels retain the dataset's numeric or textual class representation."""
    y_kind,p_kind = y.dtype.kind,p.dtype.kind
    if y_kind in 'biuf' and p_kind in 'biuf':
        require(np.isfinite(y).all() and np.isfinite(p).all(),'nonfinite OOF class labels')
    elif y_kind in 'US' and p_kind == y_kind:
        require(np.all(np.char.str_len(np.char.strip(y)) > 0)
                and np.all(np.char.str_len(np.char.strip(p)) > 0),'empty OOF class labels')
    else:
        raise ValueError('unsupported or incompatible OOF class label dtypes')
    # A class learned in a training fold need not occur among its held-out y.


def check_probe_report(report_path,model,task,identity,inputs=None):
    report = json.loads(report_path.read_text())
    for key,value in {'protocol':'readout_per_canale_v1','task':task,'probe_seed':0,'code_sha':CODE_SHA,
                      'feature_set':'channel_readout/pool','checkpoint':identity['checkpoint'],
                      'checkpoint_sha256':identity['checkpoint_sha256']}.items():
        require(report.get(key)==value,'probe report mismatch: '+key)
    require(report.get('readout',{}).get('layer')=='pool' and report['readout'].get('k_requested')==0,'probe must use full pool width')
    require(report.get('extraction_recipe',{}).get('encoder')=='teacher','probe must read teacher')
    require(set(report['datasets'])==set(DATASETS[task]),'probe datasets mismatch')
    oof = report_path.with_suffix('.oof.npz')
    require(Path(report['oof']).resolve()==oof.resolve() and sha(oof)==report['oof_sha256'],'OOF file/hash mismatch')
    with np.load(oof,allow_pickle=False) as z:
        require(z['datasets'].tolist()==DATASETS[task],'OOF datasets mismatch')
        for ds in DATASETS[task]:
            y,p,s,rows = (z[ds+'_'+k] for k in ('y','pred','s','row'))
            require(y.ndim==p.ndim==s.ndim==rows.ndim==1 and len(y)==len(p)==len(s)==len(rows)>0,'OOF shape mismatch')
            check_classification_labels(y,p)
            require(rows.dtype.kind in 'iu' and len(np.unique(rows))==len(rows),'invalid OOF rows')
            require(report['datasets'][ds]['n_oof_windows']==len(rows),'OOF count mismatch')
            if inputs is not None:
                require(report['datasets'][ds]['input_sha256']==inputs[ds]['input_sha256']
                        and report['splits_sha256']==inputs[ds]['splits_sha256'],'probe input/split identity mismatch')
    return report


def run_probe(a,code,roots):
    require(a.model is not None and a.task is not None and a.features is not None and a.receipt is not None,'probe needs model/task/features/receipt')
    require(a.checkpoint is None and a.reference_train is None and a.reference_val is None,'probe has extraneous input')
    for path in (a.out,a.out.with_suffix('.oof.npz'),Path(str(a.out)+'.provenance.json')):
        fresh(path,roots)
    receipt,inputs = guarded_features(a.features,a.receipt,a.model,a.task)
    receipt_sha = sha(a.receipt)
    command = probe_command(code,a.features,a.out,a.task)
    a.out.parent.mkdir(parents=True,exist_ok=True)
    subprocess.run(command,check=True)
    report = check_probe_report(a.out,a.model,a.task,receipt,inputs)
    require(sha(a.receipt)==receipt_sha and all(sha(v['path'])==v['sha256'] for v in inputs.values()),'extraction inputs changed during probe')
    provenance = {k:receipt[k] for k in ('model','checkpoint','checkpoint_sha256','checkpoint_step','config_file_sha256','code_sha')}
    provenance.update(mode='probe',complete=True,task=a.task,which='teacher',layer='pool',k=0,seed=0,
                      source_sha256=a.source_sha256,wrapper_sha256=a.wrapper_sha256,command=command,
                      report=str(a.out),report_sha256=sha(a.out),oof=report['oof'],oof_sha256=report['oof_sha256'],
                      extraction_receipt=str(a.receipt),extraction_receipt_sha256=receipt_sha,feature_inputs=inputs)
    write_json(Path(str(a.out)+'.provenance.json'),provenance)
    return 0


def recovery_evidence(raw):
    try:
        evidence = json.loads(raw)
    except (TypeError,ValueError) as exc:
        raise ValueError('validate-probe needs valid recovery evidence JSON') from exc
    hash_keys = ('original_source_sha256','original_wrapper_sha256','failure_log_sha256',
                 'report_sha256','oof_sha256')
    require(isinstance(evidence,dict) and set(evidence)=={'original_job_id',*hash_keys},'invalid recovery evidence keys')
    job = evidence['original_job_id']
    require(isinstance(job,str) and job.isascii() and job.isdigit() and int(job)>0,'invalid original job ID')
    require(all(is_sha(evidence[k]) for k in hash_keys),'invalid recovery evidence hashes')
    return evidence


def run_validate_probe(a,code,roots):
    """Attest completed probe outputs after a guard failure; never refit a probe."""
    require(a.model is not None and a.task is not None and a.features is not None and a.receipt is not None,
            'validate-probe needs model/task/features/receipt')
    require(a.checkpoint is None and a.reference_train is None and a.reference_val is None,'validate-probe has extraneous input')
    evidence = recovery_evidence(a.recovery_evidence)
    oof = a.out.with_suffix('.oof.npz')
    provenance_path = Path(str(a.out)+'.provenance.json')
    fresh(provenance_path,roots)
    for path in (a.out,oof):
        require(path.is_absolute() and path.is_file() and not path.is_symlink(),'recovery output must be an existing absolute file')
        require(not any(path.resolve()==r.resolve() or r.resolve() in path.resolve().parents for r in roots),'recovery output inside code')
    require(sha(a.out)==evidence['report_sha256'] and sha(oof)==evidence['oof_sha256'],'recovery output SHA mismatch')
    receipt_sha = sha(a.receipt)
    receipt,inputs = guarded_features(a.features,a.receipt,a.model,a.task)
    report = check_probe_report(a.out,a.model,a.task,receipt,inputs)
    require(sha(a.receipt)==receipt_sha and all(sha(v['path'])==v['sha256'] for v in inputs.values()),
            'extraction inputs changed during recovery')
    require(sha(a.out)==evidence['report_sha256'] and sha(oof)==evidence['oof_sha256'],'recovery outputs changed during validation')
    provenance = {k:receipt[k] for k in ('model','checkpoint','checkpoint_sha256','checkpoint_step','config_file_sha256','code_sha')}
    provenance.update(mode='probe',complete=True,task=a.task,which='teacher',layer='pool',k=0,seed=0,
                      source_sha256=a.source_sha256,wrapper_sha256=a.wrapper_sha256,
                      recovery=True,validator_mode='validate-probe',recovery_evidence=evidence,
                      validation_job_id=os.environ.get('SLURM_JOB_ID'),
                      original_probe_command=probe_command(code,a.features,a.out,a.task),
                      report=str(a.out),report_sha256=evidence['report_sha256'],oof=report['oof'],oof_sha256=report['oof_sha256'],
                      extraction_receipt=str(a.receipt),extraction_receipt_sha256=receipt_sha,feature_inputs=inputs)
    write_json(provenance_path,provenance)
    return 0


def guarded_report(path,model,task):
    provenance_path = Path(str(path)+'.provenance.json')
    provenance = json.loads(provenance_path.read_text())
    for key,value in {'mode':'probe','complete':True,'model':model,'task':task,'checkpoint_step':19618,
                      'code_sha':CODE_SHA,'which':'teacher','layer':'pool','k':0,'seed':0}.items():
        require(provenance.get(key)==value,'probe provenance mismatch: '+key)
    require(Path(provenance['report']).resolve()==path.resolve() and sha(path)==provenance['report_sha256'],'probe report changed')
    receipt_path = Path(provenance['extraction_receipt'])
    require(sha(receipt_path)==provenance['extraction_receipt_sha256'],'extraction receipt changed')
    receipt = json.loads(receipt_path.read_text())
    require(receipt.get('complete') is True and receipt.get('checkpoint_unchanged') is True,'incomplete extraction receipt')
    for key in ('model','checkpoint','checkpoint_sha256','checkpoint_step','config_file_sha256','code_sha'):
        require(receipt.get(key)==provenance[key],'report/extraction identity differs: '+key)
    origin = Path(receipt['receipt'])
    require(sha(origin)==receipt['receipt_sha256'],'original checkpoint receipt changed')
    digest,config_sha = receipt_identity(json.loads(origin.read_text()),Path(receipt['checkpoint']),model,origin)
    require((digest,config_sha)==(provenance['checkpoint_sha256'],provenance['config_file_sha256']),'checkpoint receipt identity differs')
    report = check_probe_report(path,model,task,provenance,provenance['feature_inputs'])
    require(report['oof_sha256']==provenance['oof_sha256'] and report['oof']==provenance['oof'],'OOF provenance differs')
    return {'path':str(path),'sha256':sha(path),'provenance_sha256':sha(provenance_path),
            'oof':report['oof'],'oof_sha256':report['oof_sha256'],'checkpoint_sha256':digest}


def run_compare(a,code,roots):
    require(all(getattr(a,k) is None for k in ('model','task','features','receipt','checkpoint','reference_train','reference_val')),
            'compare only accepts --out report root')
    require(a.out.is_absolute() and a.out.is_dir(),'compare root must exist')
    pairs = {}
    for task in ('p1','p2'):
        for path in (a.out/('compare_'+task+'.json'),a.out/('compare_'+task+'.json.provenance.json')):
            fresh(path,roots)
        pairs[task] = {model:guarded_report(a.out/(model+'_'+task+'_pool.json'),model,task) for model in ('B','R3c')}
    for task,inputs in pairs.items():
        output = a.out/('compare_'+task+'.json')
        command = [sys.executable,str(code/'scripts/channel_readout.py'),'--stage','compare','--single-seed','--models',
                   '--reference',inputs['R3c']['path'],'--candidate',inputs['B']['path'],'--out',str(output)]
        subprocess.run(command,check=True)
        for item in inputs.values():
            require(sha(item['path'])==item['sha256'] and sha(item['oof'])==item['oof_sha256'],'comparison input changed')
        comparison = json.loads(output.read_text())
        require(comparison.get('task')==task and comparison.get('seeds')==1,'comparison task/seed mismatch')
        require(comparison['reference'][0]['checkpoint_sha256']==inputs['R3c']['checkpoint_sha256']
                and comparison['candidate'][0]['checkpoint_sha256']==inputs['B']['checkpoint_sha256'],'comparison direction mismatch')
        write_json(Path(str(output)+'.provenance.json'),{'mode':'compare','complete':True,'task':task,'checkpoint_step':19618,
                   'reference':'R3c','candidate':'B','code_sha':CODE_SHA,'source_sha256':a.source_sha256,'wrapper_sha256':a.wrapper_sha256,
                   'command':command,'inputs':inputs,'report':str(output),'report_sha256':sha(output)})
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--mode',choices=['pose','channel','probe','compare','validate-probe'],required=True)
    ap.add_argument('--recovery-evidence',help='pinned original job and output hashes; validate-probe only')
    ap.add_argument('--model',choices=['B','R3c'])
    ap.add_argument('--out',type=Path,required=True)
    for key in ('checkpoint','receipt','features'):
        ap.add_argument('--'+key,type=Path)
    ap.add_argument('--task',choices=['p1','p2'])
    for key in ('reference-train','reference-val'):
        ap.add_argument('--'+key,type=Path)
    for key in ('source-sha256','wrapper-sha256'):
        ap.add_argument('--'+key,required=True)
    a = ap.parse_args(argv)
    require((a.recovery_evidence is not None)==(a.mode=='validate-probe'),
            'recovery evidence is required only for validate-probe')
    require(is_sha(a.source_sha256) and sha(__file__)==a.source_sha256 and is_sha(a.wrapper_sha256),'source/wrapper SHA invalid')
    require(os.environ.get('WEARUSFM_CODE_SHA')==CODE_SHA,'wrong frozen execution code')
    work,scratch,code = (Path(os.environ[k]) for k in ('WORK','SCRATCH','CODE_DIR'))
    roots = [code,work/'wearusfm',work/'wearusfm_campaigns']
    if a.mode=='validate-probe':
        return run_validate_probe(a,code,roots)
    if a.mode=='probe':
        return run_probe(a,code,roots)
    if a.mode=='compare':
        return run_compare(a,code,roots)
    require(a.model is not None and a.checkpoint is not None and a.receipt is not None and a.features is None,
            'extraction needs model/checkpoint/receipt and no features argument')
    fresh(a.out,[code,work/'wearusfm',work/'wearusfm_campaigns'])
    receipt = json.loads(a.receipt.read_text())
    digest,config_sha = check_checkpoint(a.checkpoint,a.model,receipt,a.receipt)
    base = {'model':a.model,'checkpoint':str(a.checkpoint),'checkpoint_sha256':digest,'checkpoint_step':19618,
            'config_file_sha256':config_sha,'code_sha':CODE_SHA,'source_sha256':a.source_sha256,
            'wrapper_sha256':a.wrapper_sha256,'stats_sha256':STATS_SHA,'receipt':str(a.receipt),'receipt_sha256':sha(a.receipt),
            'mode':a.mode,'slurm_job_id':os.environ.get('SLURM_JOB_ID')}
    references = {'train':a.reference_train,'val':a.reference_val}
    if a.mode=='pose':
        require(a.task is None and all(references.values()),'pose needs both B5000 reference caches and no task')
        for split,path in references.items():
            require(sha(path)==REFERENCE_SHAS[split],'B5000 reference cache SHA mismatch')
        records = pose_input_checks(work,scratch)
    else:
        require(a.task is not None and not any(references.values()),'channel needs task and no pose reference')
    a.out.mkdir(parents=True,exist_ok=False)
    outputs = {}
    if a.mode=='pose':
        for split in ('train','val'):
            path = a.out/('train_subset.npz' if split=='train' else 'val.npz')
            command = pose_command(code,a.checkpoint,path,split,work,scratch)
            subprocess.run(command,check=True)
            support = verify_pose_cache(path,references[split],a.model,split,a.checkpoint)
            provenance = {**base,**support,'cache':str(path),'cache_sha256':sha(path),'cache_bytes':path.stat().st_size,
                          'which':'student','split':split,'reference':str(references[split]),
                          'reference_sha256':REFERENCE_SHAS[split],'csv_sha256':CSV_SHA,'manifest_sha256':MANIFEST_SHA,
                          'records':records[split],'command':command}
            require(sha(a.checkpoint)==digest and sha(references[split])==REFERENCE_SHAS[split],'input changed during extraction')
            write_json(Path(str(path)+'.provenance.json'),provenance)
            outputs[split] = {'cache':str(path),'sha256':provenance['cache_sha256'],'provenance_sha256':sha(Path(str(path)+'.provenance.json'))}
    else:
        command = channel_command(code,a.checkpoint,a.out,a.task,work,scratch)
        subprocess.run(command,check=True)
        for dataset in DATASETS[a.task]:
            path = a.out/(dataset+'.npz')
            support = verify_channel_cache(path,a.task,a.checkpoint,digest)
            provenance = {**base,**support,'cache':str(path),'cache_sha256':sha(path),'cache_bytes':path.stat().st_size,
                          'task':a.task,'dataset':dataset,'split':'internal_subject_validation','command':command}
            write_json(Path(str(path)+'.provenance.json'),provenance)
            outputs[dataset] = {'cache':str(path),'sha256':provenance['cache_sha256'],'provenance_sha256':sha(Path(str(path)+'.provenance.json'))}
    require(sha(a.checkpoint)==digest and sha(a.receipt)==base['receipt_sha256']
            and sha(a.checkpoint.parent/'config.json')==config_sha,'checkpoint/receipt/config changed')
    write_json(a.out/'extraction_receipt.json',{**base,'complete':True,'outputs':outputs,'checkpoint_unchanged':True})
    print(json.dumps({'complete':True,'output':str(a.out),'model':a.model,'mode':a.mode}))
    return 0


if __name__=='__main__':
    raise SystemExit(main())
