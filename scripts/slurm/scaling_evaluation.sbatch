#!/bin/bash
#SBATCH -A IscrB_WearUsFM
#SBATCH -p boost_usr_prod
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=100G
#SBATCH --time=02:30:00
#SBATCH -J scaling_evaluation
#SBATCH -o /leonardo_work/IscrB_WearUsFM/wearusfm_runs/logs/scaling_evaluation_%j.out
#SBATCH -e /leonardo_work/IscrB_WearUsFM/wearusfm_runs/logs/scaling_evaluation_%j.out

# Exactly five 5000-step teacher extractions, each validates its own checkpoint:
# 300M pose train+val 150min; 300M P1 120min; 300M P2 150min;
# 30M P1 30min; 30M P2 45min. Total ceiling8.25GPUh; no validation-only job.
# Default150min; submit the exact --time override for each shorter allocation.
# Historical30M pose is reused, never regenerated by this launcher.
# Submit only through submit_job.py with CODE_DIR and EXPECTED_SHA exported.
set -euo pipefail
if [ "$#" -ne 5 ]; then
  echo 'usage: scaling_evaluation.sbatch <relative plan> <arm> <extract-pose|extract-classification> <none|p1|p2> <new absolute output>' >&2
  exit 2
fi
: "${WORK:?WORK}" "${CODE_DIR:?CODE_DIR}" "${EXPECTED_SHA:?EXPECTED_SHA}" "${SLURM_JOB_ID:?SLURM_JOB_ID}"
PLAN_REL="$1"
ARM="$2"
STAGE="$3"
TASK="$4"
OUT="$5"
case "$PLAN_REL" in /*|"") echo 'plan must be relative to code' >&2; exit 2;; esac
case "$ARM:$STAGE:$TASK" in
  T100-G-300M:extract-pose:none) SECONDS_EXPECTED=9000;;
  T100-G-300M:extract-classification:p1) SECONDS_EXPECTED=7200;;
  T100-G-300M:extract-classification:p2) SECONDS_EXPECTED=9000;;
  T100-G-30M:extract-classification:p1) SECONDS_EXPECTED=1800;;
  T100-G-30M:extract-classification:p2) SECONDS_EXPECTED=2700;;
  *) echo 'unregistered extraction: only five fixed5000 cells, no30M pose or validation-only job' >&2; exit 2;;
esac
if [ "${SLURM_JOB_NUM_NODES:-0}" -ne 1 ] || [ "${SLURM_CPUS_PER_TASK:-0}" -ne 8 ]; then
  echo 'one node and eight CPUs per task required' >&2; exit 2
fi
JOB_INFO=$(scontrol show job -o "$SLURM_JOB_ID")
source "$CODE_DIR/scripts/slurm/lib_code_dir.sh"
code_dir_setup
module purge
module load profile/deeplrn
module load cineca-ai/4.3.0
source "$WORK/venv_wearusfm/bin/activate"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1

python3 - "$CODE_DIR" "$PLAN_REL" "$ARM" "$OUT" "$WORK" "$JOB_INFO" "$SLURM_JOB_ID" "$SECONDS_EXPECTED" <<'PY'
from pathlib import Path
import json
import sys
import torch

code = Path(sys.argv[1]).resolve(strict=True)
plan_path = (code / sys.argv[2]).resolve(strict=True)
arm, out_arg = sys.argv[3], Path(sys.argv[4])
work = Path(sys.argv[5]).resolve()
fields = dict(part.split('=', 1) for part in sys.argv[6].split() if '=' in part)
job, expected_seconds = sys.argv[7], int(sys.argv[8])
if not job.isdigit() or int(job) <= 0 or fields.get('JobId') != job or fields.get('JobState') != 'RUNNING':
    raise SystemExit('real running SLURM job identity required')
if any(fields.get(k) != v for k, v in {'NumNodes': '1', 'NumCPUs': '8', 'NumTasks': '1'}.items()):
    raise SystemExit('exactly one node, eight CPUs and one task required')
tres = dict(part.split('=', 1) for part in fields.get('AllocTRES', '').split(',') if '=' in part)
if any(tres.get(k) != v for k, v in {'cpu': '8', 'node': '1', 'gres/gpu': '1'}.items()) or tres.get('mem') not in ('100G', '102400M'):
    raise SystemExit('actual extraction allocation differs from1GPU/8CPU/100G')
value = fields.get('TimeLimit', '')
try:
    days, clock = value.split('-', 1) if '-' in value else ('0', value)
    parts = clock.split(':')
    if len(parts) == 2 and days == '0':
        parts.insert(0, '0')
    if len(parts) != 3 or not all(p.isdigit() for p in [days, *parts]):
        raise ValueError
    hours, minutes, seconds = map(int, parts)
    if minutes >= 60 or seconds >= 60:
        raise ValueError
    total_seconds = int(days)*86400 + hours*3600 + minutes*60 + seconds
except ValueError:
    raise SystemExit('invalid extraction TimeLimit')
if total_seconds != expected_seconds:
    raise SystemExit('actual extraction walltime differs from registered cell')
if not code.is_relative_to(work / 'wearusfm_campaigns') or not plan_path.is_relative_to(code) or not plan_path.is_file():
    raise SystemExit('frozen campaign and contained plan required')
out = out_arg.resolve()
if not out_arg.is_absolute() or out_arg != out or out_arg.exists() or out_arg.is_symlink():
    raise SystemExit('canonical absolute new output directory required')
if any(out.is_relative_to(root) for root in (code, work / 'wearusfm', work / 'wearusfm_campaigns')):
    raise SystemExit('output inside code')
plan = json.loads(plan_path.read_text())
arms = ['T100-G-30M', 'T100-G-300M']
if plan.get('protocol') != 'scaling-evaluation-20261104-v1' or type(plan.get('step')) is not int or plan['step'] != 5000 or plan.get('arms') != arms or set(plan.get('checkpoints', {})) != set(arms):
    raise SystemExit('wrong scaling extraction plan/dose or missing checkpoint pin')
if torch.cuda.device_count() != 1:
    raise SystemExit('exactly one visible CUDA device required')
PY

module list 2>&1
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
ARGS=(--stage "$STAGE" --plan "$CODE_DIR/$PLAN_REL" --arm "$ARM" --step 5000
      --expected-code-sha "$EXPECTED_SHA" --out "$OUT" --device cuda)
if [ "$TASK" != none ]; then
  ARGS+=(--task "$TASK")
fi
exec python3 scripts/scaling_evaluation.py "${ARGS[@]}"
